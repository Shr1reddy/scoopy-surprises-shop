# ── Razorpay ──────────────────────────────────────────────────────────────────
# Get these from: https://dashboard.razorpay.com/app/keys
# Use Test keys while testing, Live keys when you go live
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# This is the public key (safe to expose in browser)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXXXX

# ── Twilio WhatsApp ────────────────────────────────────────────────────────────
# Get these from: https://console.twilio.com
# WhatsApp Sandbox: https://console.twilio.com/us1/develop/sms/try-it-out/whatsapp-learn
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Twilio WhatsApp sender (sandbox: whatsapp:+14155238886 | live: your approved number)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# YOUR WhatsApp Business number to receive order alerts (e.g. whatsapp:+919876543210)
OWNER_WHATSAPP_NUMBER=whatsapp:+91XXXXXXXXXX

# ── App ────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
